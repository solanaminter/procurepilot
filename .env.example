# Set to "false" to use real adapters (requires keys below). Defaults to mock mode.
MOCK_MODE=true

# LLM — any OpenAI-compatible provider. Key is read at runtime; chat UI lands in Phase 2.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# PayPal sandbox REST credentials (Phase 2). Get them at https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 product-catalog API key (Phase 2). Get one at https://trychannel3.com
CHANNEL3_API_KEY=

# AgentID — "Sign in with Google" for agents (https://www.agentid.com/developers).
# Free OIDC identity for the ProcurePilot agent: stable agent ID + verified
# human owner ("every agent has a human"). Run `npx @agentmail/agentid-cli init`
# from the repo root and fill these in. Until then the app runs on a clearly
# marked DEMO identity — no secrets required, nothing to configure.
# AGENTID_ISSUER=https://agentid.com
# AGENTID_CLIENT_ID=
# AGENTID_AGENT_SUB=
# AGENTID_AGENT_EMAIL=
# AGENTID_OWNER_NAME=Solana Minter
# AGENTID_OWNER_EMAIL=solanaminter@gmail.com
